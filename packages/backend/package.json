{
  "name": "@backnode/backend",
  "version": "1.0.0",
  "description": "NestJS backend with PostgreSQL and Prisma for Backnode OS",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prestart:dev": "tsc -p tsconfig.build.json",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "seed": "tsx src/database/seed.ts",
    "clean:tasks": "tsx src/database/clean-tasks-and-folders.ts",
    "test": "tsx test/clean-account.test.ts",
    "test:account": "tsx test/clean-account.test.ts"
  },
  "dependencies": {
    "@backnode/shared": "1.0.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/typeorm": "^12.0.2",
    "@prisma/client": "^5.22.0",
    "@types/better-sqlite3": "^9.6.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sqlite3": "^6.0.1",
    "typeorm": "^1.1.1"
